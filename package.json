{
  "name": "toodoo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "dev": "convex dev --start \"pnpm --filter @toodoo/web dev\"",
    "dev:cloud": "convex deployment select dev && convex dev --start \"pnpm --filter @toodoo/web dev\"",
    "build": "pnpm --filter @toodoo/web build",
    "test": "vitest run && pnpm --filter @toodoo/web test",
    "typecheck": "tsc -p tsconfig.json && tsc -p convex && pnpm --filter @toodoo/web typecheck"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^26.6.5",
    "convex-test": "^0.0.61",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.6"
  },
  "dependencies": {
    "convex": "^1.46.0"
  }
}
